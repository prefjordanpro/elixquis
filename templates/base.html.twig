<!doctype html>
<html lang="fr" data-bs-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Elixquis — Rhums arrangés artisanaux{% endblock %}</title>
  <meta name="description" content="{% block description %}Découvrez les rhums arrangés Elixquis. Explorez nos produits, leurs saveurs et leur disponibilité.{% endblock %}">
  <link href="{{ asset('assets/css/bootstrap.min.css') }}" rel="stylesheet">
  <link href="{{ asset('assets/css/custom.css') }}" rel="stylesheet">
  <link href="{{ asset('assets/css/elixquis.css') }}" rel="stylesheet">
  {% block stylesheets %}{% endblock %}
</head>
{% set route = app.request.attributes.get('_route')|default('') %}
{% set checkout = route in ['app_order', 'app_sendcloud_checkout', 'app_payment_success'] or (route == 'app_account_order' and order is defined and order.state == 0) %}
<body class="elixquis-site {{ checkout ? 'checkout-page' : '' }}">
  <a class="skip-link" href="#contenu">Aller au contenu</a>
  <header class="site-header" data-bs-theme="dark">
    <nav class="navbar navbar-expand-lg navbar-dark" aria-label="Navigation principale">
      <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">Elixquis</a>
        <div class="header-quick d-flex align-items-center gap-2 order-lg-3">
          <a class="header-action" href="{{ app.user ? path('app_account') : path('app_login') }}">
            <i data-feather="user" aria-hidden="true"></i><span class="d-none d-sm-inline">{{ app.user ? 'Mon compte' : 'Connexion' }}</span>
            <span class="visually-hidden d-sm-none">{{ app.user ? 'Mon compte' : 'Connexion' }}</span>
          </a>
          <a class="header-action header-cart" href="{{ path('app_cart') }}" aria-label="Panier, {{ fullCartQuantity }} article{{ fullCartQuantity > 1 ? 's' : '' }}">
            <i data-feather="shopping-cart" aria-hidden="true"></i><span>Panier</span><span class="badge cart-count">{{ fullCartQuantity }}</span>
          </a>
          {% if not checkout %}<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Afficher la navigation"><span class="navbar-toggler-icon"></span></button>{% endif %}
        </div>
        {% if checkout %}<span class="checkout-header-note"><i data-feather="lock" aria-hidden="true"></i> Votre commande en toute simplicité</span>{% else %}
        <div class="collapse navbar-collapse order-lg-2" id="navbarCollapse">
          <ul class="navbar-nav mx-lg-auto gap-lg-2">
            <li class="nav-item"><a class="nav-link {{ route == 'app_home' ? 'active' : '' }}" {{ route == 'app_home' ? 'aria-current="page"'|raw : '' }} href="{{ path('app_home') }}">Accueil</a></li>
            <li class="nav-item"><a class="nav-link {{ route in ['app_catalogue','app_product','app_category'] ? 'active' : '' }}" {{ route == 'app_catalogue' ? 'aria-current="page"'|raw : '' }} href="{{ path('app_catalogue') }}">Boutique</a></li>
            {% if allCategories|length and not checkout %}
            <li class="nav-item dropdown">
              <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Nos saveurs</button>
              <ul class="dropdown-menu">{% for category in allCategories %}
                <li><a class="dropdown-item" href="{{ path('app_category', {slug: category.slug}) }}">{{ category.name }}</a></li>
              {% endfor %}</ul>
            </li>
            {% endif %}
            {% if app.user and not checkout %}<li class="nav-item"><a class="nav-link" href="{{ path('app_account') }}">Mes commandes</a></li>{% endif %}
          </ul>
        </div>
        {% endif %}
      </div>
    </nav>
  </header>
  <main id="contenu" tabindex="-1">
    <div class="container flash-messages">
      {% for label, messages in app.flashes %}{% for message in messages %}
        <div class="alert alert-{{ label }} mt-3" role="{{ label == 'danger' ? 'alert' : 'status' }}">{{ message }}</div>
      {% endfor %}{% endfor %}
    </div>
    {% block body %}{% endblock %}
  </main>
  <footer class="site-footer" data-bs-theme="dark">
    <div class="container">
      {% if not checkout %}<div class="row g-4">
        <div class="col-lg-5">
          <a class="navbar-brand" href="{{ path('app_home') }}">Elixquis</a>
          <p class="footer-intro">Des rhums arrangés, du caractère et de la gourmandise.</p>
          <p class="small">Rhum 100% Made in France.</p>
        </div>
        <div class="col-6 col-lg-3">
          <h2 class="footer-title">La boutique</h2>
          <ul class="list-unstyled">{% for category in allCategories %}<li><a href="{{ path('app_category', {slug: category.slug}) }}">{{ category.name }}</a></li>{% endfor %}<li><a href="{{ path('app_catalogue') }}">Tous les produits</a></li></ul>
        </div>
        <div class="col-6 col-lg-4">
          <h2 class="footer-title">Votre espace</h2>
          <ul class="list-unstyled">
            <li><a href="{{ app.user ? path('app_account') : path('app_login') }}">{{ app.user ? 'Mes commandes' : 'Se connecter' }}</a></li>
            <li><a href="{{ path('app_cart') }}">Mon panier</a></li>
            {% if app.user %}<li><a href="{{ path('app_account_addresses') }}">Mes adresses</a></li>{% else %}<li><a href="{{ path('app_register') }}">Créer un compte</a></li>{% endif %}
            {% if company.email %}<li><a href="mailto:{{ company.email }}">Nous contacter</a></li>{% endif %}
          </ul>
        </div>
      </div>
      {% endif %}
      <div class="footer-bottom">
        <p>© {{ "now"|date("Y") }} Elixquis</p>
        <p>L’abus d’alcool est dangereux pour la santé, à consommer avec modération. Vente interdite aux mineurs de moins de 18 ans.</p>
      </div>
      <details class="legal-pending"><summary>Informations légales à compléter avant la mise en production</summary>
        <p>Mentions légales, CGV, CGU et politique de retour : à compléter. {% if not company.email %}Coordonnées de contact : à compléter.{% endif %}</p>
      </details>
    </div>
  </footer>
  <script src="{{ asset('assets/js/bootstrap.bundle.min.js') }}"></script>
  <script src="{{ asset('assets/js/icons.js') }}"></script>
  <script src="{{ asset('assets/js/global.js') }}"></script>
  <div class="modal fade" id="ageModal" tabindex="-1" aria-labelledby="ageModalLabel" aria-describedby="ageModalDescription" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
      <div class="modal-header"><h2 class="modal-title h4" id="ageModalLabel">Bienvenue chez Elixquis</h2></div>
      <div class="modal-body" id="ageModalDescription"><p>Ce site propose des boissons alcoolisées.</p><p class="mb-0">Pour continuer, confirmez avoir au moins 18 ans.</p></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-success" id="btn-age-yes">J’ai au moins 18 ans</button>
        <button type="button" class="btn btn-outline-secondary" id="btn-age-no">J’ai moins de 18 ans</button>
      </div>
    </div></div>
  </div>
  <script src="{{ asset('assets/js/elixquis.js') }}"></script>
  {% block javascripts %}{% endblock %}
</body>
</html>
