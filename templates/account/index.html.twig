{% extends 'base.html.twig' %}
{% block title %}Mes commandes — Elixquis{% endblock %}
{% block body %}
<div class="container my-5">
  <div class="page-heading"><div><p class="section-label">Votre espace Elixquis</p><h1>Bonjour {{ app.user.firstname }}.</h1><p>Retrouvez vos commandes et leur suivi.</p></div><a class="btn btn-outline-primary" href="{{ path('app_catalogue') }}">Retour à la boutique</a></div>
  <div class="row account-layout">
    <div class="col-md-3">{% include 'account/_menu.html.twig' %}</div>
    <div class="col-md-9">
      <h2 class="h4 mb-4">Mes commandes</h2>
      {% if orders is empty %}
      <div class="card card-body text-center py-5"><h3 class="h5">Aucune commande pour le moment</h3><p class="text-muted">Découvrez les produits de la boutique et composez votre première sélection.</p><a href="{{ path('app_catalogue') }}" class="btn btn-brand align-self-center">Voir la boutique</a></div>
      {% else %}
      <ul class="list-unstyled">
      {% for order in orders %}
        <li class="order-item d-flex align-items-center gap-3 p-3 mb-3 border rounded-4 bg-body">
          {# Uniquement les instantanés des lignes commandées, jamais le panier ou le catalogue actuel. #}
          {% set references = [] %}
          {% set referenceKeys = [] %}
          {% for line in order.orderDetails %}
            {% set snapshot = {name: line.productName|default('Produit commandé'), image: line.productIllustration|default('')|trim} %}
            {% set key = [snapshot.name, snapshot.image]|json_encode %}
            {% if key not in referenceKeys %}
              {% set referenceKeys = referenceKeys|merge([key]) %}
              {% set references = references|merge([snapshot]) %}
            {% endif %}
          {% endfor %}
          <div class="order-thumbnails" role="group" aria-label="Produits de cette commande">
            {% for snapshot in references|slice(0, 3) %}
              <span class="order-thumbnail" role="img" aria-label="{{ snapshot.name }}">
                <i data-feather="shopping-bag" aria-hidden="true"></i>
                {% if snapshot.image %}<img src="{{ asset('uploads/' ~ snapshot.image) }}" alt="" width="56" height="56" loading="lazy" decoding="async" onerror="this.hidden = true">{% endif %}
              </span>
            {% else %}
              <span class="order-thumbnail" role="img" aria-label="Commande sans illustration disponible"><i data-feather="shopping-bag" aria-hidden="true"></i></span>
            {% endfor %}
            {% if references|length > 3 %}<span class="order-thumbnail-more" aria-label="{{ references|length - 3 }} références supplémentaires">+{{ references|length - 3 }}</span>{% endif %}
          </div>
          <div class="flex-grow-1">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
              <div><strong>{{ order.reference }}</strong><span class="text-muted small d-block">{{ order.createdAt|date('d/m/Y à H:i') }}</span></div>
              <strong>{{ order.totalWt|price }} TTC</strong>
            </div>
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mt-3">
              {{ include('admin/state.html.twig', {field: {value: order.state}}) }}
              <a class="btn btn-sm btn-outline-primary" href="{{ path('app_account_order', {id_order: order.id}) }}">Voir le détail →</a>
            </div>
            {% if order.shipment %}<div class="mt-3 small"><strong>{{ order.carrierName }}</strong> · {{ order.shipment.customerStatus }}{% if order.shipment.trackingNumber %}<span class="d-block">Numéro de suivi : {{ order.shipment.trackingNumber }}</span>{% endif %}{% if order.shipment.trackingUrl %}<a class="btn btn-sm btn-outline-primary mt-2" href="{{ order.shipment.trackingUrl }}" target="_blank" rel="noopener noreferrer">Suivre mon colis</a>{% endif %}</div>{% endif %}
          </div>
        </li>
      {% endfor %}
      </ul>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
