{% extends 'base.html.twig' %}
{% block title %}Mon adresse — Elixquis{% endblock %}
{% block body %}
<div class="container my-5">
  <div class="page-heading"><div><p class="section-label">Votre espace Elixquis</p><h1>Mon adresse</h1><p>Vérifiez les coordonnées pour la livraison de votre commande.</p></div><a href="{{ path('app_account_addresses') }}">Mes adresses →</a></div>
  <div class="row account-layout">
    <div class="col-md-3">{% include 'account/_menu.html.twig' %}</div>
    <div class="col-md-9"><div class="account-form">
      {{ form_start(addressForm) }}
      <div class="row g-3">
        <div class="col-md-6">{{ form_row(addressForm.firstname, {attr: {autocomplete: 'given-name'}}) }}</div>
        <div class="col-md-6">{{ form_row(addressForm.lastname, {attr: {autocomplete: 'family-name'}}) }}</div>
        <div class="col-12">{{ form_row(addressForm.address, {attr: {autocomplete: 'street-address'}}) }}</div>
        <div class="col-md-6">{{ form_row(addressForm.postal, {attr: {autocomplete: 'postal-code'}}) }}</div>
        <div class="col-md-6">{{ form_row(addressForm.city, {attr: {autocomplete: 'address-level2'}}) }}</div>
        <div class="col-md-6">{{ form_row(addressForm.country, {attr: {autocomplete: 'country'}}) }}</div>
        <div class="col-md-6">{{ form_row(addressForm.phone, {attr: {autocomplete: 'tel', inputmode: 'tel'}}) }}</div>
      </div>
      {{ form_end(addressForm) }}
    </div></div>
  </div>
</div>
{% endblock %}
