{% extends 'base.html.twig' %}

{% block body %}
<div class="container my-5">
  <div class="page-heading"><div><p class="section-label">Votre espace Elixquis</p><h1>Mes adresses</h1><p>Retrouvez les adresses disponibles pour vos prochaines commandes.</p></div></div>

  <div class="row account-layout">
    <div class="col-md-3">
      {% include 'account/_menu.html.twig' %}
    </div>

    <div class="col-md-9">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Adresses enregistrées</h2>
        <a href="{{ path('app_account_address_form') }}" class="btn btn-sm btn-primary rounded-pill">
          + Ajouter une adresse
        </a>
      </div>

      {% if app.user.addresses|length == 0 %}
        <div class="alert alert-info text-center p-4 rounded-3">
          <p class="mb-0">Vous n'avez pas encore enregistré d'adresse sur la boutique <strong>Elixquis</strong>.</p>
        </div>
      {% else %}
        <div class="row g-3">
          {% for address in app.user.addresses %}
            <div class="col-md-6">
              <div class="card address-card shadow-sm h-100 border-0 rounded-4">
                <div class="card-body d-flex flex-column">
                  <h6 class="fw-bold mb-1">
                    <i data-feather="map-pin" class="text-primary me-1"></i>
                    {{ address.firstname }} {{ address.lastname }}
                  </h6>
                  <p class="text-muted small mb-3">
                    {{ address.address }}<br>
                    {{ address.postal }} {{ address.city }}<br>
                    {{ address.country }}
                  </p>
                  <div class="mt-auto d-flex justify-content-between">
                    <a href="{{ path('app_account_address_form', { id : address.id }) }}" 
                       class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                      Modifier
                    </a>
                    <form method="post" action="{{ path('app_account_address_delete', {id: address.id}) }}">
                      <input type="hidden" name="_token" value="{{ csrf_token('address_delete_' ~ address.id) }}">
                      <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">Supprimer</button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% endblock %}
