{% if order.state == 7 %}
<div class="alert alert-warning">Votre demande est en cours de traitement.</div>
{% elseif order.state == 6 %}
<div class="alert alert-success">Votre commande a été annulée et remboursée.</div>
{% elseif order.state == 4 %}
<div class="alert alert-info">
  Votre commande a été annulée.
  {% if order.latestCancellationRequest and order.latestCancellationRequest.previousState in [1, 2] %}
    {% if order.stripeRefundStatus in ['failed', 'canceled'] %}
      Votre demande a été acceptée. Le remboursement nécessite une intervention de notre équipe.
    {% else %}
      Votre demande a été acceptée. Le remboursement est en cours de traitement ; il n’est pas encore confirmé.
    {% endif %}
  {% endif %}
</div>
{% endif %}
{% if order.latestCancellationRequest and order.latestCancellationRequest.decision == 'refused' %}
<div class="alert alert-info">Votre demande d’annulation a été refusée. Votre commande reprend son traitement.</div>
{% endif %}
{% if order.canRequestCancellation %}
<form class="card card-body my-3" method="post" action="{{ path('app_account_order_cancel', {id_order: order.id}) }}"
      onsubmit="return confirm('Confirmer votre demande d’annulation ?');">
  <input type="hidden" name="_token" value="{{ csrf_token('cancel_' ~ order.id) }}">
  <label for="cancellation-reason">Raison de la demande (facultative)</label>
  <textarea id="cancellation-reason" name="reason" class="form-control my-2" rows="3" maxlength="1000"></textarea>
  <p class="text-muted">{{ order.state == 0 ? 'Votre commande impayée sera annulée immédiatement.' : 'Notre équipe examinera votre demande. Aucun remboursement n’est déclenché lors de son envoi.' }}</p>
  <button class="btn btn-outline-danger align-self-start" type="submit">Demander l’annulation</button>
</form>
{% elseif order.state not in [7, 6] %}
<p class="text-muted">Cette commande ne peut plus être annulée en ligne.</p>
{% endif %}
