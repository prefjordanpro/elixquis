{% set client = entity.instance %}
{% set last = field.customOptions.get('lastOrder') %}
<section class="card mb-4"><div class="card-body">
    <h2 class="h5">Compte</h2>
    <dl class="row mb-0">
        <dt class="col-sm-4">Email</dt><dd class="col-sm-8">{{ client.email }}</dd>
        <dt class="col-sm-4">Email vérifié</dt><dd class="col-sm-8"><span class="badge {{ client.emailVerifiedAt ? 'bg-success' : 'bg-secondary' }}">{{ client.emailVerificationStatus }}</span></dd>
        <dt class="col-sm-4">Date de vérification</dt><dd class="col-sm-8">{{ client.emailVerifiedAt ? client.emailVerifiedAt|date('d/m/Y H:i') : 'Non vérifié' }}</dd>
        <dt class="col-sm-4 text-muted">Type de compte</dt><dd class="col-sm-8 text-muted">{{ 'ROLE_ADMIN' in client.roles ? 'Administrateur' : 'Client' }}</dd>
    </dl>
    {% if not client.emailVerifiedAt %}
        <form method="post" action="{{ path('app_admin_user_resend_verification', {id: client.id}) }}" class="mt-3">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_user_verify_' ~ client.id) }}">
            <button class="btn btn-secondary">Renvoyer l'email de vérification</button>
        </form>
    {% endif %}
</div></section>
<section class="card mb-4"><div class="card-body">
    <h2 class="h5">Commandes</h2>
    <dl class="row">
        <dt class="col-sm-4">Nombre total de commandes</dt><dd class="col-sm-8" data-client-order-count>{{ client.orderCount }}</dd>
        <dt class="col-sm-4">Dernière commande</dt><dd class="col-sm-8">{% if last %}<a href="{{ path('admin_order_detail', {entityId: last.id}) }}">{{ last.reference }}</a>{% else %}Aucune commande{% endif %}</dd>
        {% if last %}<dt class="col-sm-4">Date de la dernière commande</dt><dd class="col-sm-8">{{ last.createdAt|date('d/m/Y H:i') }}</dd>
        <dt class="col-sm-4">Statut</dt><dd class="col-sm-8">{% include 'admin/state.html.twig' with {field: {value: last.state}} %}</dd>{% endif %}
        <dt class="col-sm-4">Total payé conservé</dt><dd class="col-sm-8" data-client-paid-total>{{ (field.customOptions.get('paidCents') / 100)|number_format(2, ',', ' ') }} €</dd>
    </dl>
    <p class="small text-muted">Selon les états enregistrés : hors commandes annulées, impayées et remboursements confirmés. Les remboursements partiels externes ne sont pas suivis ici.</p>
    <a class="btn btn-secondary" href="{{ path('admin_order_index', {filters: {user: {comparison: '=', value: client.id}}}) }}">Voir les commandes de ce client</a>
</div></section>
<section class="card"><div class="card-body">
    <h2 class="h5">Adresses</h2>
    {% for address in client.addresses %}
        <address class="mb-3">{{ address.firstname }} {{ address.lastname }}<br>{{ address.address }}<br>{{ address.postal }} {{ address.city }}<br>{{ address.country }}</address>
    {% else %}<p>Aucune adresse enregistrée</p>{% endfor %}
</div></section>
