{% set next = {0: [1, 'Vérifier le paiement Stripe'], 1: [2, 'Passer en préparation'], 2: [3, 'Expédier'], 3: [5, 'Marquer livrée']} %}
<div class="d-flex gap-2 flex-wrap my-3">
{% if next[order.state] is defined %}
  <form method="post" action="{{ path('app_admin_order_state', {id: order.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('order_state_' ~ order.id) }}">
    <input type="hidden" name="state" value="{{ next[order.state][0] }}">
    <button type="submit" class="btn btn-primary">{{ next[order.state][1] }}</button>
  </form>
{% endif %}
{% if order.state in [0, 1, 2] %}
  <form method="post" action="{{ path('app_admin_order_state', {id: order.id}) }}"
        onsubmit="return confirm(this.dataset.confirmation);"
        data-confirmation="{{ order.state in [1, 2] ? 'Confirmer l’annulation de cette commande payée ? Le stock réservé sera restitué. Le remboursement doit être effectué manuellement dans Stripe ; aucun remboursement automatique ne sera déclenché.' : 'Confirmer l’annulation de cette commande ? Le stock réservé sera restitué.' }}">
    <input type="hidden" name="_token" value="{{ csrf_token('order_state_' ~ order.id) }}">
    <input type="hidden" name="state" value="4">
    <button type="submit" class="btn btn-danger">Annuler la commande</button>
  </form>
{% endif %}
</div>
{% if order.state in [1, 2] %}
<p class="text-danger">En cas d’annulation, le remboursement doit être effectué manuellement dans Stripe. Aucun remboursement automatique ne sera déclenché.</p>
{% elseif order.state == 4 %}
<div class="alert alert-warning">Commande annulée. Si un paiement a été encaissé, le remboursement doit être effectué manuellement dans Stripe. L’annulation ne déclenche aucun remboursement automatique.</div>
{% endif %}
