{% extends 'base.html.twig' %}
{% block title %}Adresse et livraison — Elixquis{% endblock %}
{% block body %}
<div class="container my-5">
  {% include 'components/_steps.html.twig' with {step: 2} %}
  <div class="page-heading"><div><p class="section-label">Préparer ma commande</p><h1>Adresse & livraison</h1><p>Choisissez où recevoir votre commande, puis votre transporteur.</p></div></div>
  {{ form_start(deliverForm) }}
  <div class="checkout-layout">
    <div>
      <fieldset class="card card-body mb-4">
        <legend>Votre adresse de livraison</legend>
        <p class="text-muted small">Sélectionnez une adresse enregistrée.</p>
        {% for choice in deliverForm.addresses %}
        <div class="form-check choice-card">{{ form_widget(choice) }}{{ form_label(choice) }}</div>
        {% endfor %}
        {{ form_errors(deliverForm.addresses) }}
        <a href="{{ path('app_account_address_form') }}" class="btn btn-outline-primary align-self-start mt-2">Ajouter une adresse</a>
      </fieldset>
      <fieldset class="card card-body">
        <legend>Votre mode de livraison</legend>
        <p class="text-muted small">Le tarif associé à chaque transporteur est indiqué ci-dessous.</p>
        {% for choice in deliverForm.carriers %}
        <div class="form-check choice-card">{{ form_widget(choice) }}{{ form_label(choice) }}</div>
        {% endfor %}
        {{ form_errors(deliverForm.carriers) }}
      </fieldset>
    </div>
    <aside class="card summary-card"><div class="card-body">
      <h2>Votre sélection</h2>
      {% for item in cart %}
      <div class="d-flex justify-content-between gap-3 mb-3"><span>{{ item.object.name }} <span class="text-muted">× {{ item.qty }}</span></span><strong class="text-nowrap">{{ (item.object.pricewt * item.qty)|price }}</strong></div>
      {% endfor %}
      <div class="summary-total d-flex justify-content-between gap-2"><strong>Sous-total TTC</strong><strong>{{ totalWt|price }}</strong></div>
      <p class="small text-muted mt-3">Le total avec livraison sera présenté sur le récapitulatif, avant le paiement.</p>
      {{ form_row(deliverForm._token) }}
      <button type="submit" class="btn btn-success btn-lg w-100">Continuer</button>
      <a href="{{ path('app_cart') }}" class="d-block text-center mt-3">Retour au panier</a>
      <p class="small text-muted mt-3 mb-0"><i data-feather="lock"></i> Vous validerez le montant avant d’être redirigé vers Stripe.</p>
    </div></aside>
  </div>
  {{ form_end(deliverForm, {render_rest: false}) }}
</div>
{% endblock %}
