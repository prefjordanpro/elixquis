{% extends 'base.html.twig' %}
{% block title %}{{ title }} — Elixquis{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('assets/css/auth.css') }}">{% endblock %}
{% block body %}
<div class="container my-5"><div class="row justify-content-center"><div class="col-md-8 col-lg-6 auth-form-column">
<div class="card shadow-sm auth-card"><div class="card-body p-4 p-lg-5">
<h1 class="h3">{{ title }}</h1><p class="text-muted">{{ intro }}</p>
{% form_theme form 'bootstrap_5_layout.html.twig' %}
{{ form_start(form) }}{{ form_errors(form) }}{{ form_widget(form) }}
<button class="btn btn-brand btn-lg w-100" type="submit">{{ button }}</button>{{ form_end(form) }}
<p class="text-center mt-4 mb-0">{% if app.request.attributes.get('_route') == 'app_password_forgot' %}<a href="{{ path('app_login') }}">← Retour à la connexion</a>{% else %}<a href="{{ path('app_login') }}">Connexion</a> · <a href="{{ path('app_register') }}">Inscription</a>{% endif %}</p>
</div></div></div></div></div>
{% endblock %}
