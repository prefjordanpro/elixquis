{% extends 'base.html.twig' %}
{% block title %}Elixquis — Découvrez nos rhums arrangés{% endblock %}
{% block body %}
<section class="home-hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="section-label">Rhums arrangés artisanaux</p>
      <h1>Du caractère.<br>De la gourmandise.</h1>
      <p class="lead">Bienvenue chez Elixquis. Découvrez nos rhums arrangés et trouvez les saveurs qui vous ressemblent.</p>
      <div class="hero-actions">
        <a class="btn btn-success btn-lg" href="{{ path('app_catalogue') }}">Découvrir la boutique <i data-feather="arrow-right"></i></a>
        {% if allCategories|length %}<a class="btn btn-outline-secondary btn-lg" href="#nos-saveurs">Explorer les saveurs</a>{% endif %}
      </div>
    </div>
    <div class="hero-image">
      {% if siteHeaders|length %}
      <div id="homeCarousel" class="carousel slide" aria-label="L’univers Elixquis">
        <div class="carousel-inner">
          {% for header in siteHeaders %}
          <div class="carousel-item {{ loop.first ? 'active' : '' }}">
            <img src="{{ asset('uploads/' ~ header.illustration) }}" alt="{{ header.title }}" width="800" height="650" loading="{{ loop.first ? 'eager' : 'lazy' }}" fetchpriority="{{ loop.first ? 'high' : 'auto' }}">
            <div class="hero-caption"><h2>{{ header.title }}</h2>
              {% if header.content %}<p>{{ header.content }}</p>{% endif %}
              {% if header.buttonLink and header.buttonTitle %}<a href="{{ header.buttonLink }}">{{ header.buttonTitle }} →</a>{% endif %}
            </div>
          </div>
          {% endfor %}
        </div>
        {% if siteHeaders|length > 1 %}
        <div class="carousel-indicators">{% for header in siteHeaders %}<button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="{{ loop.index0 }}" class="{{ loop.first ? 'active' : '' }}" {{ loop.first ? 'aria-current="true"'|raw : '' }} aria-label="Afficher {{ header.title }}"></button>{% endfor %}</div>
        <button class="carousel-control-prev" type="button" data-bs-target="#homeCarousel" data-bs-slide="prev"><span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="visually-hidden">Précédent</span></button>
        <button class="carousel-control-next" type="button" data-bs-target="#homeCarousel" data-bs-slide="next"><span class="carousel-control-next-icon" aria-hidden="true"></span><span class="visually-hidden">Suivant</span></button>
        {% endif %}
      </div>
      {% elseif productsInHomepage|length %}
      <img src="{{ asset('uploads/' ~ (productsInHomepage|first).illustration) }}" alt="{{ (productsInHomepage|first).name }}" width="800" height="650" fetchpriority="high">
      {% else %}
      <img src="{{ asset('uploads/beach-4405371_640.jpg') }}" alt="Une côte ensoleillée, l’univers Elixquis" width="640" height="427" fetchpriority="high">
      {% endif %}
    </div>
  </div>
</section>
<div class="container">
  {% if productsInHomepage|length %}
  <section class="section-space" aria-labelledby="selection-title">
    <div class="section-heading"><div><p class="section-label">La sélection Elixquis</p><h2 id="selection-title">À découvrir, à savourer.</h2><p>Explorez les produits mis en avant dans notre boutique.</p></div><a href="{{ path('app_catalogue') }}">Tous les produits →</a></div>
    <div class="product-grid">
      {% for product in productsInHomepage|slice(0, 8) %}<div class="product-cell">{% include 'components/_product_card.html.twig' with {product: product, heading: 'h3'} %}</div>{% endfor %}
    </div>
  </section>
  {% endif %}
  {% if allCategories|length %}
  <section class="section-space pt-0" id="nos-saveurs" aria-labelledby="categories-title">
    <div class="section-heading"><div><p class="section-label">À chacun ses envies</p><h2 id="categories-title">Choisissez vos saveurs.</h2></div></div>
    <div class="category-grid">{% for category in allCategories %}<a class="category-tile" href="{{ path('app_category', {slug: category.slug}) }}"><span>{{ category.name }}</span><i data-feather="arrow-right"></i></a>{% endfor %}</div>
  </section>
  {% endif %}
  <section class="story-band" aria-labelledby="story-title">
    <div><p class="section-label">L’esprit Elixquis</p><h2 id="story-title">Un univers artisanal,<br>des saveurs à explorer.</h2></div>
    <div><p>Fruits, épices, gourmandise : prenez le temps de découvrir les recettes de notre boutique. Chaque fiche présente sa description, son prix et sa disponibilité.</p><a class="btn btn-outline-primary" href="{{ path('app_catalogue') }}">Trouver mon prochain rhum</a></div>
  </section>
  {% include 'components/_reassurance.html.twig' %}
</div>
{% endblock %}
