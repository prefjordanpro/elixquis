{% extends 'base.html.twig' %}
{% block title %}{{ homeContent.pageTitle }}{% endblock %}
{% block body %}
<section class="home-hero home-hero-immersive">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="section-label">{{ homeContent.heroEyebrow }}</p>
      <h1>{{ homeContent.heroTitle }}<br>{{ homeContent.heroTitleSecondLine }}<br><span>{{ homeContent.heroAccent }}</span></h1>
      <p class="lead">{{ homeContent.heroParagraph }}</p>
      <div class="hero-actions">
        <a class="btn btn-brand btn-lg" href="{{ homeContent.heroUrl }}">{{ homeContent.heroCta|trim }} <i data-feather="arrow-right"></i></a>
      </div>
    </div>
    <div class="hero-stage"><div class="hero-image">
      {% if siteHeaders|length %}
      <div id="homeCarousel" class="carousel slide" aria-label="L’univers Elixquis">
        <div class="carousel-inner">
          {% for header in siteHeaders %}
          <div class="carousel-item {{ loop.first ? 'active' : '' }}">
            <img src="{{ asset('uploads/' ~ header.illustration) }}" alt="{{ header.alt ?: header.title }}" width="800" height="650" loading="{{ loop.first ? 'eager' : 'lazy' }}" fetchpriority="{{ loop.first ? 'high' : 'auto' }}">
            <div class="hero-caption"><h2>{{ header.title }}</h2>
              {% if header.content %}<p>{{ header.content }}</p>{% endif %}
              {% if header.buttonLink and header.buttonTitle %}<a class="editorial-link" href="{{ header.buttonLink }}">{{ header.buttonTitle }}</a>{% endif %}
            </div>
          </div>
          {% endfor %}
        </div>
        {% if siteHeaders|length > 1 %}
        <div class="carousel-indicators">{% for header in siteHeaders %}<button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="{{ loop.index0 }}" class="{{ loop.first ? 'active' : '' }}" {{ loop.first ? 'aria-current="true"'|raw : '' }} aria-label="Afficher {{ header.title }}"></button>{% endfor %}</div>
        {% endif %}
      </div>
      {% else %}
      <img src="{{ asset(homeContent.heroImage) }}" alt="{{ homeContent.heroAlt }}" width="1536" height="1024" fetchpriority="high">
      {% endif %}
    </div><p class="hero-image-note">{{ homeContent.heroNote }}</p></div>
  </div>
</section>
<section class="story-band home-story" aria-labelledby="story-title">
  <div class="container editorial-grid">
    <div class="editorial-copy">
      <p class="editorial-index"><span class="editorial-number" aria-hidden="true">{{ homeContent.storyNumber }}</span><span class="section-label">{{ homeContent.storyEyebrow }}</span></p>
      <h2 id="story-title">{{ homeContent.storyTitle }}<br><span>{{ homeContent.storyAccent }}</span></h2>
      <p class="story-origin">{{ homeContent.storySubtitle }}</p>
      <p>{{ homeContent.storyParagraph }}</p>
      <a class="editorial-link" href="{{ homeContent.storyUrl }}">{{ homeContent.storyLinkLabel }}</a>
    </div>
    <figure class="editorial-photo">
      <img src="{{ asset(homeContent.storyImage) }}" alt="{{ homeContent.storyAlt }}" width="1536" height="1024" loading="lazy" decoding="async">
      <figcaption>{{ homeContent.storyCaption }}</figcaption>
    </figure>
  </div>
</section>
  {% if productsInHomepage|length %}
  <section class="section-space home-selection-section" aria-labelledby="selection-title">
    <div class="container home-selection-inner">
    <div class="section-heading"><div><p class="section-label">{{ homeContent.selectionEyebrow }}</p><h2 id="selection-title">{{ homeContent.selectionTitle }}</h2><p>{{ homeContent.selectionDescription }}</p></div><a class="editorial-link" href="{{ homeContent.selectionUrl }}">{{ homeContent.selectionLinkLabel }}</a></div>
    <div class="product-grid home-selection">
      {% for product in productsInHomepage|slice(0, 3) %}<div class="product-cell">{% include 'components/_product_card.html.twig' with {product: product, heading: 'h3'} %}</div>{% endfor %}
    </div>
    </div>
  </section>
  {% endif %}
<div class="container">
  {% if allCategories|length %}
  <section class="section-space pt-0" id="nos-saveurs" aria-labelledby="categories-title">
    <div class="section-heading"><div><p class="section-label">{{ homeContent.flavoursEyebrow }}</p><h2 id="categories-title">{{ homeContent.flavoursTitle }}</h2></div></div>
    <div class="category-grid">{% for category in allCategories %}<a class="category-tile" href="{{ path('app_category', {slug: category.slug}) }}"><span>{{ category.name }}</span><i data-feather="arrow-right"></i></a>{% endfor %}</div>
    <a class="editorial-link mt-4" href="{{ homeContent.flavoursUrl }}">{{ homeContent.flavoursCta|trim }} <span aria-hidden="true">→</span></a>
  </section>
  {% endif %}
</div>
<section class="brand-story section-space" aria-labelledby="passion-title">
  <div class="container editorial-grid">
    <div class="editorial-copy">
      <p class="editorial-index"><span class="editorial-number" aria-hidden="true">{{ homeContent.passionNumber }}</span><span class="section-label">{{ homeContent.passionEyebrow }}</span></p>
      <h2 id="passion-title">{{ homeContent.passionTitle }}<br>{{ homeContent.passionTitleSecondLine|trim }} <span>{{ homeContent.passionAccent }}</span></h2>
      <p>{{ homeContent.passionParagraph }}</p>
      <p>{{ homeContent.passionSecondParagraph }}</p>
    </div>
    <figure class="editorial-photo">
      <img src="{{ asset(homeContent.passionImage) }}" alt="{{ homeContent.passionAlt }}" width="1536" height="1024" loading="lazy" decoding="async">
      <figcaption>{{ homeContent.passionCaption }}</figcaption>
    </figure>
  </div>
</section>
<div class="container">
  {% include 'home/_reassurance.html.twig' %}
</div>
{% endblock %}
