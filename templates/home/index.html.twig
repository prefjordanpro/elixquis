{% extends 'base.html.twig' %}
{% block title %}Elixquis — Découvrez nos rhums arrangés{% endblock %}
{% block body %}
<section class="home-hero home-hero-immersive">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="section-label">{{ home_content('hero_label') }}</p>
      <h1>{{ home_content('hero_title')|nl2br }}<br><span>{{ home_content('hero_italic') }}</span></h1>
      <p class="lead">{{ home_content('hero_description') }}</p>
      <div class="hero-actions">
        <a class="btn btn-brand btn-lg" href="{{ home_content('hero_url') }}">{{ home_content('hero_cta') }} <i data-feather="arrow-right"></i></a>
      </div>
    </div>
    <div class="hero-stage"><div class="hero-image">
      {% if siteHeaders|length %}
      <div id="homeCarousel" class="carousel slide" aria-label="L’univers Elixquis">
        <div class="carousel-inner">
          {% for header in siteHeaders %}
          <div class="carousel-item {{ loop.first ? 'active' : '' }}">
            <img src="{{ asset('uploads/' ~ header.illustration) }}" alt="{{ header.title }}" width="800" height="650" loading="{{ loop.first ? 'eager' : 'lazy' }}" fetchpriority="{{ loop.first ? 'high' : 'auto' }}">
            <div class="hero-caption"><h2>{{ header.title }}</h2>
              {% if header.content %}<p>{{ header.content }}</p>{% endif %}
              {% if header.buttonLink and header.buttonTitle %}<a class="editorial-link" href="{{ header.buttonLink }}">{{ 'parfum' in header.buttonTitle|lower ? 'Découvrir nos rhums' : header.buttonTitle }}</a>{% endif %}
            </div>
          </div>
          {% endfor %}
        </div>
        {% if siteHeaders|length > 1 %}
        <div class="carousel-indicators">{% for header in siteHeaders %}<button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="{{ loop.index0 }}" class="{{ loop.first ? 'active' : '' }}" {{ loop.first ? 'aria-current="true"'|raw : '' }} aria-label="Afficher {{ header.title }}"></button>{% endfor %}</div>
        {% endif %}
      </div>
      {% else %}
      <img src="{{ asset(home_content('hero_image')) }}" alt="{{ home_content('hero_alt') }}" width="1536" height="1024" fetchpriority="high">
      {% endif %}
    </div><p class="hero-image-note">{{ home_content('hero_note') }}</p></div>
  </div>
</section>
<section class="story-band home-story" aria-labelledby="story-title">
  <div class="container editorial-grid">
    <div class="editorial-copy">
      <p class="editorial-index"><span class="editorial-number" aria-hidden="true">01</span><span class="section-label">{{ home_content('story_label') }}</span></p>
      <h2 id="story-title">{{ home_content('story_title') }}<br><span>{{ home_content('story_italic') }}</span></h2>
      <p class="story-origin">{{ home_content('story_intro') }}</p>
      <p>{{ home_content('story_text') }}</p>
      <a class="editorial-link" href="{{ home_content('story_url') }}">{{ home_content('story_cta') }}</a>
    </div>
    <figure class="editorial-photo">
      <img src="{{ asset(home_content('story_image')) }}" alt="{{ home_content('story_alt') }}" width="1536" height="1024" loading="lazy" decoding="async">
      <figcaption>{{ home_content('story_caption') }}</figcaption>
    </figure>
  </div>
</section>
<div class="container">
  {% if productsInHomepage|length %}
  <section class="section-space home-selection-section" aria-labelledby="selection-title">
    <div class="section-heading"><div><p class="section-label">{{ home_content('selection_label') }}</p><h2 id="selection-title">{{ home_content('selection_title') }}</h2><p>{{ home_content('selection_text') }}</p></div><a class="editorial-link" href="{{ path('app_catalogue') }}">{{ home_content('selection_cta') }}</a></div>
    <div class="product-grid home-selection">
      {% for product in productsInHomepage|slice(0, 3) %}<div class="product-cell">{% include 'components/_product_card.html.twig' with {product: product, heading: 'h3'} %}</div>{% endfor %}
    </div>
  </section>
  {% endif %}
  {% if allCategories|length %}
  <section class="section-space pt-0" id="nos-saveurs" aria-labelledby="categories-title">
    <div class="section-heading"><div><p class="section-label">{{ home_content('flavours_label') }}</p><h2 id="categories-title">{{ home_content('flavours_title') }}</h2></div></div>
    <div class="category-grid">{% for category in allCategories %}<a class="category-tile" href="{{ path('app_category', {slug: category.slug}) }}"><span>{{ category.name }}</span><i data-feather="arrow-right"></i></a>{% endfor %}</div>
    <a class="editorial-link mt-4" href="{{ path('app_catalogue') }}#catalogue-saveurs">{{ home_content('flavours_cta') }} <span aria-hidden="true">→</span></a>
  </section>
  {% endif %}
</div>
<section class="brand-story section-space" aria-labelledby="passion-title">
  <div class="container editorial-grid">
    <div class="editorial-copy">
      <p class="editorial-index"><span class="editorial-number" aria-hidden="true">02</span><span class="section-label">{{ home_content('passion_label') }}</span></p>
      <h2 id="passion-title">{{ home_content('passion_title')|nl2br }} <span>{{ home_content('passion_italic') }}</span></h2>
      <p>{{ home_content('passion_text') }}</p>
      <p>{{ home_content('passion_second') }}</p>
    </div>
    <figure class="editorial-photo">
      <img src="{{ asset(home_content('passion_image')) }}" alt="{{ home_content('passion_alt') }}" width="1536" height="1024" loading="lazy" decoding="async">
      <figcaption>{{ home_content('passion_caption') }}</figcaption>
    </figure>
  </div>
</section>
<div class="container">
  {% include 'components/_reassurance.html.twig' %}
</div>
{% endblock %}
