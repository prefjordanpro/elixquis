{% extends 'base.html.twig' %}

{% block body %}
<div class="container marketing">
    {# --- tes colonnes + featurettes inchangées --- #}

<div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4 text-center justify-content-center">
  {% for product in productsInHomepage %}
    <div class="col">
      <a href="{{ path('app_product', { slug: product.slug }) }}" class="text-decoration-none text-reset d-block">
        <img
          src="/uploads/{{ product.illustration }}"
          alt="{{ product.name }}"
          class="rounded-circle img-fluid shadow-sm"
          style="width: 140px; height: 140px; object-fit: cover;"
          loading="lazy"
        >
        <h2 class="h6 fw-semibold mt-3 mb-1 text-truncate">{{ product.name }}</h2>

        {# Optionnel : petite description sur 2 lignes max #}
        <p class="small text-muted mb-2" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
          {{ product.description|striptags }}
        </p>

        <span class="btn btn-sm btn-secondary rounded-pill">
          Découvrir
        </span>
      </a>
    </div>
  {% endfor %}
</div>

    <hr class="featurette-divider">

    <div class="row featurette">
    <div class="col-md-7">
        <h2 class="featurette-heading fw-normal lh-1">Découvrez nos rhums arrangés.
        <span class="text-body-secondary">Choisissez vos saveurs.</span>
        </h2>
        <p class="lead">Parcourez notre catalogue et retrouvez la description, le prix et la disponibilité de chaque produit.</p>
    </div>
    <div class="col-md-5">
        <svg class="bd-placeholder-img bd-placeholder-img-lg featurette-image img-fluid mx-auto" width="500" height="500" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Illustration Elixquis" preserveAspectRatio="xMidYMid slice" focusable="false"><title>Elixquis</title><rect width="100%" height="100%" fill="var(--bs-secondary-bg)"/><text x="50%" y="50%" fill="var(--bs-secondary-color)" dy=".3em">Elixquis</text></svg>
    </div>
    </div>

    <hr class="featurette-divider">

    <div class="row featurette">
    <div class="col-md-7 order-md-2">
        <h2 class="featurette-heading fw-normal lh-1">Commandez en toute simplicité.
        <span class="text-body-secondary">Préparez votre sélection.</span>
        </h2>
        <p class="lead">Ajoutez vos produits au panier, choisissez votre adresse et votre transporteur, puis réglez votre commande.</p>
    </div>
    <div class="col-md-5 order-md-1">
        <svg class="bd-placeholder-img bd-placeholder-img-lg featurette-image img-fluid mx-auto" width="500" height="500" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Illustration Elixquis" preserveAspectRatio="xMidYMid slice" focusable="false"><title>Elixquis</title><rect width="100%" height="100%" fill="var(--bs-secondary-bg)"/><text x="50%" y="50%" fill="var(--bs-secondary-color)" dy=".3em">Elixquis</text></svg>
    </div>
    </div>

    <hr class="featurette-divider">

    <div class="row featurette">
    <div class="col-md-7">
        <h2 class="featurette-heading fw-normal lh-1">Suivez vos commandes.
        <span class="text-body-secondary">Depuis votre espace client.</span>
        </h2>
        <p class="lead">Consultez votre historique, les détails de vos achats et leur statut de préparation ou de livraison.</p>
    </div>
    <div class="col-md-5">
        <svg class="bd-placeholder-img bd-placeholder-img-lg featurette-image img-fluid mx-auto" width="500" height="500" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Illustration Elixquis" preserveAspectRatio="xMidYMid slice" focusable="false"><title>Elixquis</title><rect width="100%" height="100%" fill="var(--bs-secondary-bg)"/><text x="50%" y="50%" fill="var(--bs-secondary-color)" dy=".3em">Elixquis</text></svg>
    </div>
    </div>

    <hr class="featurette-divider">
</div>
{% endblock %}
