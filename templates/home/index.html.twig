{% extends 'base.html.twig' %}
{% block title %}Elixquis — Découvrez nos rhums arrangés{% endblock %}
{% block body %}
<section class="home-hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="section-label">Rhums arrangés artisanaux</p>
      <h1>Le caractère<br>du rhum.<br><span>L’exquis des fruits.</span></h1>
      <p class="lead">Des rhums arrangés, des fruits et des épices. Un univers gourmand à découvrir, pour des moments conviviaux.</p>
      <div class="hero-actions">
        <a class="btn btn-brand btn-lg" href="{{ path('app_catalogue') }}">Découvrir la boutique <i data-feather="arrow-right"></i></a>
      </div>
    </div>
    <div class="hero-stage"><div class="hero-image">
      {% if siteHeaders|length %}
      <div id="homeCarousel" class="carousel slide" aria-label="L’univers Elixquis">
        <div class="carousel-inner">
          {% for header in siteHeaders %}
          <div class="carousel-item {{ loop.first ? 'active' : '' }}">
            <img src="{{ asset('uploads/' ~ header.illustration) }}" alt="{{ header.title }}" width="800" height="650" loading="{{ loop.first ? 'eager' : 'lazy' }}" fetchpriority="{{ loop.first ? 'high' : 'auto' }}">
            <div class="hero-caption"><h2>{{ header.title }}</h2>
              {% if header.content %}<p>{{ header.content }}</p>{% endif %}
              {% if header.buttonLink and header.buttonTitle %}<a class="editorial-link" href="{{ header.buttonLink }}">{{ 'parfum' in header.buttonTitle|lower ? 'Découvrir nos rhums' : header.buttonTitle }}</a>{% endif %}
            </div>
          </div>
          {% endfor %}
        </div>
        {% if siteHeaders|length > 1 %}
        <div class="carousel-indicators">{% for header in siteHeaders %}<button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="{{ loop.index0 }}" class="{{ loop.first ? 'active' : '' }}" {{ loop.first ? 'aria-current="true"'|raw : '' }} aria-label="Afficher {{ header.title }}"></button>{% endfor %}</div>
        {% endif %}
      </div>
      {% else %}
      <img src="{{ asset('images/editorial/degustation-ambree-v2.jpg') }}" alt="Illustration d’ambiance : un verre ambré et un zeste d’orange" width="1536" height="1024" fetchpriority="high">
      {% endif %}
    </div><p class="hero-image-note">Fruits · Épices · Caractère</p></div>
  </div>
</section>
<div class="container">
  {% if productsInHomepage|length %}
  <section class="section-space" aria-labelledby="selection-title">
    <div class="section-heading"><div><p class="section-label">La sélection Elixquis</p><h2 id="selection-title">À découvrir, à savourer.</h2><p>Explorez les produits mis en avant dans notre boutique.</p></div><a class="btn btn-outline-secondary" href="{{ path('app_catalogue') }}">Voir toute la boutique →</a></div>
    <div class="product-grid">
      {% for product in productsInHomepage|slice(0, 8) %}<div class="product-cell">{% include 'components/_product_card.html.twig' with {product: product, heading: 'h3'} %}</div>{% endfor %}
    </div>
  </section>
  {% endif %}
  {% if allCategories|length %}
  <section class="section-space pt-0" id="nos-saveurs" aria-labelledby="categories-title">
    <div class="section-heading"><div><p class="section-label">À chacun ses envies</p><h2 id="categories-title">Choisissez vos saveurs.</h2></div></div>
    <div class="category-grid">{% for category in allCategories %}<a class="category-tile" href="{{ path('app_category', {slug: category.slug}) }}"><span>{{ category.name }}</span><i data-feather="arrow-right"></i></a>{% endfor %}</div>
  </section>
  {% endif %}
</div>
<section class="story-band" aria-labelledby="story-title">
  <div class="container editorial-grid">
    <div class="editorial-copy">
      <p class="editorial-index"><span class="editorial-number" aria-hidden="true">01</span><span class="section-label">L’esprit Elixquis</span></p>
      <h2 id="story-title">L’élixir.<br><span>L’exquis.</span></h2>
      <p class="story-origin">Deux mots, une invitation à découvrir.</p>
      <p>Elixquis associe l’univers de l’élixir à la délicatesse de l’exquis. Les fruits et les épices y rencontrent le caractère du rhum, avec une place essentielle accordée aux ingrédients naturels.</p>
      <a class="btn btn-outline-primary" href="{{ path('app_catalogue') }}">Explorer les recettes</a>
    </div>
    <figure class="editorial-photo">
      <img src="{{ asset('images/editorial/degustation-ambree-v2.jpg') }}" alt="Illustration d’ambiance : lumière chaude sur un verre de dégustation" width="1536" height="1024" loading="lazy" decoding="async">
      <figcaption>Le goût des moments partagés</figcaption>
    </figure>
  </div>
</section>
<section class="brand-story section-space" aria-labelledby="passion-title">
  <div class="container editorial-grid">
    <div class="editorial-copy">
      <p class="editorial-index"><span class="editorial-number" aria-hidden="true">02</span><span class="section-label">L’histoire d’un passionné</span></p>
      <h2 id="passion-title">Tout commence<br>par une <span>découverte.</span></h2>
      <p>Lors d’un séjour au ski entre amis, Paul découvre les rhums arrangés. Le mélange du rhum, des fruits et des épices lui donne envie de créer ses propres compositions, d’abord pour lui et ses proches.</p>
      <p>Ces moments partagés font naître Elixquis : une passion des saveurs et l’envie de la transmettre.</p>
    </div>
    <figure class="editorial-photo">
      <img src="{{ asset('images/editorial/fruits-epices-v2.jpg') }}" alt="Illustration d’ambiance : oranges, litchis, vanille et cannelle sur une table claire" width="1536" height="1024" loading="lazy" decoding="async">
      <figcaption>Fruits &amp; épices · L’inspiration</figcaption>
    </figure>
  </div>
</section>
<div class="container">
  {% include 'components/_reassurance.html.twig' %}
</div>
{% endblock %}
