{% extends 'base.html.twig' %}
{% block title %}Confirmation de commande — Elixquis{% endblock %}
{% block stylesheets %}<link href="{{ asset('assets/css/purchase.css') }}" rel="stylesheet">{% endblock %}
{% block body %}
<div class="container my-5 purchase-page confirmation-page">
  {% include 'components/_steps.html.twig' with {step: 5} %}
  <div class="card card-body text-center py-5">
    <div class="mb-4"><i data-feather="check-circle" class="text-success" aria-hidden="true"></i></div>
    <p class="section-label">Confirmation Stripe reçue</p>
    <h1 class="mb-3">Merci pour votre commande.</h1>
    <p class="lead">{{ order.reference }}</p>
    <p class="text-muted">Votre paiement a été confirmé.<br>Retrouvez le détail et le suivi de votre commande dans votre espace client.</p>
    <div class="confirmation-details">
      <div><span class="cart-field-label">Montant payé TTC</span><strong class="detail-price">{{ order.totalWt|price }}</strong></div>
      <div><span class="cart-field-label">Livraison</span><strong>{{ order.carrierName }}</strong><p class="small text-muted mb-0">Frais inclus : {{ order.carrierPrice|price }}</p></div>
    </div>
    <div class="hero-actions justify-content-center">
      <a href="{{ path('app_account_order', {id_order: order.id}) }}" class="btn btn-success btn-lg">Voir ma commande</a>
      <a href="{{ path('app_catalogue') }}" class="btn btn-outline-primary btn-lg">Retour à la boutique</a>
    </div>
  </div>
</div>
{% endblock %}
