{% extends 'base.html.twig' %}
{% block title %}{{ category.name }} — Elixquis{% endblock %}
{% block body %}
<div class="container my-5" data-catalogue>
  <div class="page-heading"><div><p class="section-label">La boutique Elixquis</p><h1>{{ category.name }}</h1><p>Parcourez les saveurs, comparez les prix et découvrez votre prochain produit.</p></div></div>
  <nav class="category-links" aria-label="Catégories de produits">
    <a class="category-link {{ app.request.attributes.get('_route') == 'app_catalogue' ? 'active' : '' }}" href="{{ path('app_catalogue') }}">Tous les produits</a>
    {% for item in allCategories %}<a class="category-link {{ category.slug is defined and category.slug == item.slug ? 'active' : '' }}" href="{{ path('app_category', {slug: item.slug}) }}">{{ item.name }}</a>{% endfor %}
  </nav>
  {% if products|length %}
  <div class="catalogue-tools" data-catalogue-tools hidden>
    <div><label class="form-label" for="product-search">Rechercher un produit</label><input class="form-control" type="search" id="product-search" placeholder="Nom ou catégorie…" data-product-search></div>
    <div><label class="form-label" for="product-sort">Trier par</label><select class="form-select" id="product-sort" data-product-sort><option value="name">Nom du produit</option><option value="price-asc">Prix croissant</option><option value="price-desc">Prix décroissant</option></select></div>
    <label class="form-check"><input class="form-check-input" type="checkbox" data-product-available> Disponibles uniquement</label>
  </div>
  <p class="text-muted mb-4" data-product-count role="status" aria-live="polite">{{ products|length }} produit{{ products|length > 1 ? 's' : '' }}</p>
  <div class="product-grid" data-product-grid>
    {% for product in products %}<div class="product-cell" data-product data-name="{{ product.name }} {{ product.category ? product.category.name : '' }}" data-price="{{ product.pricewt }}" data-available="{{ product.stock > 0 ? '1' : '0' }}">
      {% include 'components/_product_card.html.twig' with {product: product, heading: 'h2'} %}
    </div>{% endfor %}
  </div>
  <div class="card card-body text-center mt-4" data-product-empty hidden><h2 class="h4">Aucun produit ne correspond à votre recherche.</h2><p class="text-muted">Essayez un autre nom ou affichez tous les produits.</p><button type="button" class="btn btn-outline-primary align-self-center" data-filter-reset>Réinitialiser les filtres</button></div>
  <noscript><p class="text-muted mt-3">Tous les produits sont affichés. Les liens de catégories restent disponibles sans JavaScript.</p></noscript>
  {% else %}
  <div class="card card-body text-center py-5"><h2 class="h4">Aucun produit pour le moment</h2><p class="text-muted">Explorez les autres catégories de la boutique.</p><a class="btn btn-success align-self-center" href="{{ path('app_catalogue') }}">Voir tous les produits</a></div>
  {% endif %}
</div>
{% endblock %}
