{% extends 'base.html.twig' %}
{% block title %}Mon panier — Elixquis{% endblock %}
{% block stylesheets %}<link href="{{ asset('assets/css/purchase.css') }}?v=20261005-footer-common" rel="stylesheet">{% endblock %}
{% block body %}
<div class="container my-5 purchase-page cart-page">
  {% include 'components/_steps.html.twig' with {step: 1} %}
  <div class="page-heading"><div><p class="section-label">Votre sélection</p><h1>Mon panier</h1><p>{{ fullCartQuantity }} article{{ fullCartQuantity > 1 ? 's' : '' }}</p></div><a href="{{ path('app_catalogue') }}">Continuer mes achats →</a></div>
  {% if cart is empty %}
  <div class="card card-body text-center py-5"><h2 class="h3">Votre panier est vide</h2><p class="text-muted">Découvrez les produits de notre boutique et composez votre sélection.</p><a href="{{ path('app_catalogue') }}" class="btn btn-brand align-self-center">Découvrir la boutique</a></div>
  {% else %}
  <div class="row g-4">
    <div class="col-lg-8">
      {% for product in cart %}
      <article class="card cart-line mb-3"><div class="card-body">
        <div class="row g-3 align-items-center">
          <div class="col-3 col-md-2"><div class="ratio ratio-1x1"><img src="{{ asset('uploads/' ~ product.object.illustration) }}" alt="{{ product.object.name }}" class="img-fluid rounded" width="120" height="120"></div></div>
          <div class="col-9 col-md-5"><h2 class="h6 mb-1"><a class="text-reset text-decoration-none" href="{{ path('app_product', {slug: product.object.slug}) }}">{{ product.object.name }}</a></h2><span class="small text-muted">Prix unitaire : {{ product.object.pricewt|price }}</span></div>
          <div class="col-7 col-md-3"><span class="cart-field-label">Quantité</span><div class="quantity-controls" role="group" aria-label="Quantité de {{ product.object.name }}">
            <form method="post" action="{{ path('app_cart_decrease', {id: product.object.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('cart') }}"><button type="submit" class="btn btn-outline-secondary btn-sm" aria-label="Diminuer la quantité de {{ product.object.name }}" {{ product.qty == 1 ? 'disabled' : '' }}>&minus;</button></form>
            <span class="badge text-bg-secondary" aria-label="{{ product.qty }} unité{{ product.qty > 1 ? 's' : '' }}">x{{ product.qty }}</span>
            <form method="post" action="{{ path('app_cart_add', {id: product.object.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('cart') }}"><button type="submit" class="btn btn-outline-secondary btn-sm" aria-label="Augmenter la quantité de {{ product.object.name }}" {{ product.qty >= product.object.stock ? 'disabled' : '' }}>+</button></form>
          </div></div>
          <div class="col-5 col-md-2 text-end"><span class="cart-field-label">Sous-total TTC</span><strong>{{ (product.qty * product.object.pricewt)|price }}</strong><form method="post" action="{{ path('app_cart_delete', {id: product.object.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('cart') }}"><button type="submit" class="btn btn-link btn-sm text-danger" aria-label="Supprimer {{ product.object.name }} du panier">Supprimer</button></form></div>
        </div>
      </div></article>
      {% endfor %}
      <form method="post" action="{{ path('app_cart_remove') }}" onsubmit="return confirm('Vider votre panier ?');"><input type="hidden" name="_token" value="{{ csrf_token('cart') }}"><button type="submit" class="btn btn-link text-muted">Vider le panier</button></form>
    </div>
    <div class="col-lg-4"><aside class="card summary-card"><div class="card-body">
      <h2>Votre récapitulatif</h2>
      <div class="summary-row"><span>Sous-total · {{ fullCartQuantity }} article{{ fullCartQuantity > 1 ? 's' : '' }}</span><strong>{{ totalWt|price }}</strong></div>
      <div class="summary-row"><span>Livraison</span><span class="text-muted">À choisir</span></div>
      <p class="text-muted small mt-3">Les frais seront précisés à l’étape livraison. Aucun paiement à cette étape.</p>
      <div class="summary-total d-flex justify-content-between align-items-center gap-2"><strong>Total hors livraison</strong><strong>{{ totalWt|price }}</strong></div>
      <a href="{{ path('app_sendcloud_checkout') }}" class="btn btn-brand w-100 mt-4 btn-lg">Poursuivre ma commande <i data-feather="arrow-right" aria-hidden="true"></i></a>
      <p class="text-muted small text-center mt-3 mb-0"><i data-feather="lock"></i> Paiement via Stripe · TVA incluse</p>
    </div></aside></div>
  </div>
  {% endif %}
</div>
{% endblock %}
